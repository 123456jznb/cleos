<?xml version="1.0" encoding="utf-8"?>
<!-- The API key is encrypted with a key that lives in this device's keystore and never
     leaves it, so a restored copy of the settings could not be decrypted anyway.
     Leaving it out avoids restoring a blob that only produces a decrypt error. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/secrets.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
